{
  "appId": "com.urbanoffline.app",
  "appName": "UrbanOffline",
  "webDir": "dist",
  "plugins": {
    "CapacitorSQLite": {
      "iosDatabaseLocation": "Library/CapacitorDatabase"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a",
      "overlaysWebView": false
    }
  },
  "server": {
    "androidScheme": "https"
  },
  "android": {},
  "ios": {
    "contentInset": "always"
  }
}

