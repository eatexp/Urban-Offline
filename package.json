    "generate-manifest": "node scripts/generate-manifest.js",
    "prebuild": "npm run fetch-content && npm run generate-manifest",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open": "cap open"
