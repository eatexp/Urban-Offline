{
  "name": "urban-offline",
  "description": "Offline-First Emergency Preparedness App",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "build": "vite build",
    "extract-wasm": "node scripts/extract-wasm.cjs",
