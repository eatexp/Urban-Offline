{
    "inkVersion": 20,
    "root": [
        [
            "^CHECK SAFETY: Is the area safe for YOU?",
            "\n",
            "ev",
            "str",
            "^Yes, it's safe",
            "/str",
            "/ev",
            {
                "*": "0.c-0"
            },
            "ev",
            "str",
            "^No, there is danger",
            "/str",
            "/ev",
            {
                "*": "0.c-1"
            },
            {
                "c-0": [
                    "\n",
                    "^approach",
                    "\n",
                    {
                        "->": "CHECK_RESPONSE"
                    },
                    {
                        "->": "0.g-0"
                    }
                ],
                "c-1": [
                    "\n",
                    "^danger",
                    "\n",
                    {
                        "->": "DANGER"
                    },
                    {
                        "->": "0.g-0"
                    }
                ],
                "g-0": [
                    "done",
                    "\n"
                ]
            }
        ],
        "done",
        {
            "CHECK_RESPONSE": [
                "^Shout and shake the casualty. Do they respond?",
                "\n",
                "ev",
                "str",
                "^No response",
                "/str",
                "/ev",
                {
                    "*": ".^.c-0"
                },
                "ev",
                "str",
                "^They moaned/moved",
                "/str",
                "/ev",
                {
                    "*": ".^.c-1"
                },
                {
                    "c-0": [
                        "\n",
                        "^CHECK BREATHING: Look, listen and feel for 10 seconds.",
                        "\n",
                        "ev",
                        "str",
                        "^Not breathing / Occasional gasp",
                        "/str",
                        "/ev",
                        {
                            "*": ".^.^.c-1"
                        },
                        {
                            "c-1": [
                                "\n",
                                "^START CPR NOW",
                                "\n",
                                "^1. Place heel of hand on center of chest.",
                                "\n",
                                "^2. Interlock fingers.",
                                "\n",
                                "^3. Compress 5-6cm deep, 100-120 times/min.",
                                "\n",
                                "end",
                                {
                                    "->": "CHECK_RESPONSE.g-0"
                                }
                            ]
                        }
                    ],
                    "c-1": [
                        "\n",
                        "^Place in Recovery Position and monitor.",
                        "\n",
                        "end",
                        {
                            "->": "CHECK_RESPONSE.g-0"
                        }
                    ]
                },
                {
                    "g-0": [
                        "done",
                        "\n"
                    ]
                }
            ],
            "DANGER": [
                "^Do NOT become a second casualty. Move to safety and call emergency services if possible.",
                "\n",
                "end",
                "\n"
            ]
        }
    ],
    "listDefs": {}
}